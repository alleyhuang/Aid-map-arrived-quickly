.page {
  width: 100vw;
  min-height: 100vh;
  background: #f5f6fa;
}

.page-content {
  width: 100vw;
  box-sizing: border-box;
}

.content-inner {
  padding: 32rpx;
}

/* 公告栏 */
.chat-announcement {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.chat-announcement text {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 消息列表 */
.forum-msg {
  margin-bottom: 32rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}

.forum-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.forum-identity {
  font-size: 26rpx;
  color: #666;
}

.forum-time {
  font-size: 24rpx;
  color: #999;
}

.forum-content {
  font-size: 28rpx;
  color: #333;
  line-height: 1.6;
}

/* 输入栏 */
.forum-input-bar {
  position: fixed;
  bottom: 120rpx;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  background: #fff;
  box-shadow: 0 -4rpx 16rpx rgba(0,0,0,0.06);
  display: flex;
  align-items: center;
}

.forum-input {
  flex: 1;
  height: 72rpx;
  background: #f5f6fa;
  border-radius: 36rpx;
  padding: 0 32rpx;
  font-size: 28rpx;
  margin-right: 24rpx;
}

.forum-send-btn {
  width: 120rpx;
  height: 72rpx;
  line-height: 72rpx;
  background: #07c160;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
  padding: 0;
}

.chat-header-safe {
  height: env(safe-area-inset-top, 44px);
  width: 100vw;
  background: #00C37D;
  position: fixed;
  top: 0;
  left: 0;
  z-index: 100;
}
.chat-header {
  width: 100vw;
  height: 260rpx;
  background: #00C37D;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  position: relative;
  padding-bottom: 32rpx;
  margin-top: env(safe-area-inset-top, 44px);
}
.chat-title {
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
.chat-subtitle {
  color: #fff;
  font-size: 26rpx;
  opacity: 0.9;
}
.chat-scroll {
  width: 100vw;
  height: calc(100vh - 180rpx);
  padding-bottom: 180rpx;
  background: #f7f8fa;
}
.forum-msg.user {
  background: #fff3f3;
  border: 2rpx solid #ffb3b3;
}
.forum-meta {
  display: flex;
  flex-direction: row;
  align-items: center;
  font-size: 22rpx;
  color: #888;
  margin-bottom: 8rpx;
}
.forum-identity {
  margin-right: 16rpx;
  color: #00C37D;
}
.forum-time {
  color: #bbb;
}
.forum-content {
  font-size: 30rpx;
  color: #222;
}
.forum-input-bar {
  position: fixed;
  left: 0;
  bottom: 120rpx;
  width: 100vw;
  background: #fff;
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 16rpx 24rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.04);
  z-index: 99;
}
.forum-input {
  flex: 1;
  height: 64rpx;
  font-size: 28rpx;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 0 16rpx;
  margin-right: 16rpx;
  background: #fafafa;
}
.forum-send-btn {
  background: #00C37D;
  color: #fff;
  font-size: 28rpx;
  border-radius: 12rpx;
  padding: 0 32rpx;
  height: 64rpx;
  border: none;
} 