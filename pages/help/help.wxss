/* 页面容器 */
.page {
  height: 100vh;
  background: #f5f6fa;
  position: relative;
}

.page-content {
  height: 1060rpx;
  overflow: scroll;
  position: relative;
  top: 20rpx;
}

.content-inner {
  padding: 20rpx;
}

/* 头部样式 */
.fixed-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  z-index: 100;
  background: #00c37d;
}

.register-header {
  width: 100vw;
  height: 260rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.register-title {
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.register-subtitle {
  color: #fff;
  font-size: 26rpx;
  margin-bottom: 0;
  opacity: 0.9;
}

/* 主要内容区域 */
.main-scroll {
  box-sizing: border-box;
  padding: 32rpx;
}

/* 底部按钮 */
.footer {
  position: fixed;
  bottom: 120rpx; /* 在 tabbar 上方 */
  left: 0;
  width: 100%;
  padding: 24rpx;
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
  z-index: 99;
}

/* 表单区块 */
.form-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.form-label {
  font-size: 28rpx;
  color: #222;
  margin-bottom: 12rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
}

.tip {
  font-size: 22rpx;
  color: #888;
  margin-left: 8rpx;
  font-weight: normal;
}

/* 输入框样式 */
.form-input {
  width: 100%;
  height: 64rpx;
  font-size: 28rpx;
  border: none;
  border-bottom: 2rpx solid #eee;
  margin-top: 4rpx;
  background: transparent;
  padding: 0 8rpx;
}

.form-input.valid {
  border-bottom-color: #00c37d;
}

.form-input.invalid {
  border-bottom-color: #ff4d4f;
}

/* 文本域样式 */
.form-textarea {
  width: 100%;
  height: 200rpx;
  font-size: 28rpx;
  padding: 12rpx;
  border: 2rpx solid #e5eefd;
  border-radius: 12rpx;
  margin-top: 4rpx;
  background: #f5f6fa;
}

/* 紧急程度选择 */
.urgency-levels {
  display: flex;
  gap: 12rpx;
}

.urgency-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  color: #666;
  border: 2rpx solid #e5eefd;
}

/* 帮助类型选择 */
.tag-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 4rpx;
}

.tag {
  background: #f5f6fa;
  color: #00c37d;
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  border: 2rpx solid #e5eefd;
}

.tag.selected {
  background: #00c37d;
  color: #fff;
  border: 2rpx solid #00c37d;
}

/* 图片上传 */
.image-uploader {
  margin-top: 12rpx;
}

.image-list {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.image-item {
  width: 180rpx;
  height: 180rpx;
  position: relative;
}

.image-item image {
  width: 100%;
  height: 100%;
  border-radius: 12rpx;
}

.delete-btn {
  position: absolute;
  top: -16rpx;
  right: -16rpx;
  width: 40rpx;
  height: 40rpx;
  line-height: 36rpx;
  text-align: center;
  background: rgba(0, 0, 0, 0.5);
  color: #fff;
  border-radius: 50%;
  font-size: 32rpx;
}

.upload-btn {
  width: 180rpx;
  height: 180rpx;
  background: #f5f6fa;
  border: 2rpx dashed #e5eefd;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 48rpx;
  color: #999;
}

/* 位置选择 */
.location-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.location-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #00c37d;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  padding: 0;
}

.location-txt {
  font-size: 28rpx;
  color: #999;
  max-width: 540rpx;
}

.location-tip {
  font-size: 28rpx;
  color: #00c37d;
  margin-left: 10rpx;
  min-width: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  word-break: keep-all;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  margin-bottom: 20rpx;
}

.submit-btn.disabled {
  opacity: 0.6;
  background: #ccc;
}

/* 预览弹窗 */
.preview-modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 1000;
  display: none;
}

.preview-modal.show {
  display: block;
}

.preview-mask {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.6);
}

.preview-content {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx;
  box-sizing: border-box;
  max-height: 80vh;
  display: flex;
  flex-direction: column;
}

.preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.preview-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.close-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #999;
}

.preview-scroll {
  flex: 1;
  overflow-y: auto;
}

.preview-item {
  margin-bottom: 24rpx;
}

.preview-label {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 8rpx;
  display: block;
}

.preview-value {
  font-size: 28rpx;
  color: #333;
}

.preview-types {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.preview-type-tag {
  background: #f5f6fa;
  color: #00c37d;
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
}

.preview-images {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.preview-images image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 8rpx;
  object-fit: cover;
}

.preview-footer {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid #eee;
}

.cancel-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #f5f6fa;
  color: #666;
  border-radius: 44rpx;
  font-size: 32rpx;
}

.confirm-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #00c37d;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
}

.confirm-btn.disabled {
  opacity: 0.6;
  background: #ccc;
}
