<wxs module="util" src="./util.wxs"></wxs>
<view class="page">
  <page-header title="发布求助" subtitle="您的每一次求助，都将得到及时的响应" />

  <scroll-view class="page-content" scroll-y show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="content-inner">
      <!-- 紧急程度选择 -->
      <view class="form-section">
        <view class="form-label">紧急程度</view>
        <view class="urgency-levels">
          <view
            wx:for="{{urgencyLevels}}"
            wx:key="value"
            class="urgency-btn {{urgency === item.label ? 'active' : ''}}"
            style="{{urgency === item.label ? 'background: ' + item.color + '; color: #fff;' : ''}}"
            data-value="{{item.label}}"
            bind:tap="onUrgencyChange"
          >
            {{item.label}}
          </view>
        </view>
      </view>

      <!-- 联系方式 -->
      <view class="form-section">
        <view class="form-label"
          >联系方式 <text class="tip">（不会直接展示，仅用于紧急联系）</text></view
        >
        <input
          type="number"
          placeholder="请输入手机号码"
          value="{{formData.phone}}"
          data-field="phone"
          bindinput="onInput"
          class="form-input {{formStatus.phoneValid ? 'valid' : formData.phone ? 'invalid' : ''}}"
        />
      </view>

      <!-- 紧急联系人（仅特急时显示） -->
      <view class="form-section" wx:if="{{urgency === 'emergency'}}">
        <view class="form-label">紧急联系人 <text class="tip">（特急情况下必填）</text></view>
        <input
          type="text"
          placeholder="请输入联系人姓名"
          value="{{formData.contactName}}"
          data-field="contactName"
          bindinput="onInput"
          class="form-input"
        />
        <input
          type="text"
          placeholder="请输入与联系人关系"
          value="{{formData.contactRelation}}"
          data-field="contactRelation"
          bindinput="onInput"
          class="form-input"
        />
      </view>

      <!-- 帮助类型选择 -->
      <view class="form-section">
        <view class="form-label">选择帮助类型 <text class="tip">（可多选）</text></view>
        <view class="tag-group">
          <view
            wx:for="{{helpTypes}}"
            class="tag {{selectedTypes && util.includes(selectedTypes, item) ? 'selected' : ''}}"
            wx:key="*this"
            bindtap="selectHelpType"
            data-index="{{index}}"
            data-type="{{item}}"
          >
            {{item}}
          </view>
        </view>
      </view>

      <!-- 情况描述 -->
      <view class="form-section">
        <view class="form-label"
          >情况描述 <text class="tip">（请详细描述，以便志愿者更好地提供帮助）</text></view
        >
        <textarea
          placeholder="请详细描述您的情况..."
          value="{{formData.desc}}"
          data-field="desc"
          bindinput="onInput"
          maxlength="500"
          class="form-textarea"
        />
      </view>

      <!-- 位置信息 -->
      <view class="form-section">
        <view class="form-label">求助位置</view>
        <view class="location-row">
          <button
            wx:if="{{!location}}"
            class="location-btn"
            type="default"
            bindtap="onRequestLocationAuth"
          >
            选择位置
          </button>
          <block wx:else>
            <view class="location-txt">
              已选择：{{location.address}}
            </view>
            <text class="location-tip" bind:tap="onChooseLocation">更改地址</text>
          </block>
        </view>
      </view>

      <button
        class="submit-btn {{formStatus.canSubmit ? '' : 'disabled'}}"
        bind:tap="onSubmit"
        type="primary"
        disabled="{{!formStatus.canSubmit}}"
      >
        预览并发布
      </button>
    </view>
  </scroll-view>

  <tabbar active="help" />
</view>
