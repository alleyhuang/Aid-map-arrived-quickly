<view class="page">
  <!-- 通用 header -->
  <page-header title="成为帮助人" subtitle="感谢您自愿成为帮助人，希望您在帮助他人的过程中也保护好自身安全" />

  <scroll-view class="page-content" scroll-y show-scrollbar="{{false}}" enhanced="{{true}}">
    <view class="content-inner">
      <view class="register-top-btns">
        <view
          class="reg-type-btn {{regType === 'pro' ? 'active' : ''}}"
          bindtap="onSelectType"
          data-type="pro"
        >
          我具备专业技能
        </view>
        <view
          class="reg-type-btn {{regType === 'help' ? 'active' : ''}}"
          bindtap="onSelectType"
          data-type="help"
        >
          我能为他人提供帮助
        </view>
      </view>

      <view class="form-section">
        <view class="form-label"
          >姓名 <text class="tip">（可用昵称，方便沟通时称呼）</text></view
        >
        <input
          class="form-input"
          value="{{name}}"
          placeholder="请输入真实姓名"
          bindinput="onNameInput"
        />
      </view>

      <view class="form-section">
        <view class="form-label"
          >电话 <text class="tip">（请务必输入可用于联系的真实号码，感谢您的帮助）</text>
          </view>
        <input
          class="form-input"
          value="{{phone}}"
          placeholder="请输入手机号"
          bindinput="{{onPhoneInput}}"
        />
      </view>

      <view class="form-section">
        <view class="location-row">
          <button
            wx:if="{{!location}}"
            class="location-btn"
            type="default"
            bindtap="onRequestLocationAuth"
          >
            选择可帮助地点
          </button>
          <block wx:else>
            <view class="location-txt">
              已选择：{{location.address}}
            </view>
            <text class="location-tip" bind:tap="onChooseLocation">更改地址</text>
          </block>
        </view>
      </view>

      <!-- 专业人士表单 -->
      <block wx:if="{{regType === 'pro'}}">
        <view class="form-section">
          <view class="form-label">选择您的专业范围</view>
          <view class="tag-group">
            <view
              class="tag {{selectedProType==index?'selected':''}}"
              wx:for="{{proTypes}}"
              wx:key="index"
              bindtap="onSelectProType"
              data-index="{{index}}"
              data-type="pro"
              >{{item}}</view
            >
          </view>
          <input
            wx:if="{{showProOther}}"
            class="form-input"
            name="proOther"
            maxlength="15"
            placeholder="请输入自定义专业（15字内）"
          />
        </view>
      </block>

      <!-- 志愿者表单 -->
      <block wx:if="{{regType === 'help'}}">
        <view class="form-section">
          <view class="form-label">选择您的帮助形式</view>
          <view class="tag-group">
            <view
              class="tag {{selectedHelpType==index?'selected':''}}"
              wx:for="{{helpTypes}}"
              wx:key="index"
              bindtap="onSelectHelpType"
              data-index="{{index}}"
              data-type="help"
              >{{item}}</view
            >
          </view>
          <input
            wx:if="{{showHelpOther}}"
            class="form-input"
            name="helpOther"
            maxlength="15"
            placeholder="请输入自定义帮助（15字内）"
          />
        </view>
        <view class="form-section">
          <view class="form-label"
            >您具体能提供的帮助 <text class="tip">（如：汽车、摩托车等）</text></view
          >
          <input class="form-input" value="{{helpDetail}}" placeholder="请输入具体内容" bindinput="onChangeHelpDetail"/>
        </view>
      </block>

      <view class="form-section">
        <view class="form-label">帮助范围（0.5-20km）</view>
        <slider
          class="slider"
          min="0.5"
          max="20"
          step="0.5"
          value="{{range}}"
          show-value
          name="range"
          activeColor="#00C37D"
          backgroundColor="#e5eefd"
          blockColor="#00C37D"
          bindchange="onRangeChange"
        />
      </view>

      <view class="form-section">
        <checkbox-group bind:change="onAgreeChange">
          <label class="agreement-row">
            <checkbox value="agree" checked="{{agree}}" color="#00C37D" />
            <text>我已阅读并同意</text>
          </label>
        </checkbox-group>
        <view class="agreement-links">
          <text class="link">服务协议</text>
          <text>与</text>
          <text class="link">隐私条款</text>
        </view>
      </view>

      <button type="primary" class="submit-btn" bindtap="onSubmit" disabled="{{!agree}}">
        提交注册
      </button>
    </view>
  </scroll-view>

  <!-- 通用 tabbar -->
  <tabbar active="register" />
</view>
