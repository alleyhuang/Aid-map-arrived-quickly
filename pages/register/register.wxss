.page {
  height: 100vh;
  background: #f5f6fa;
  position: relative;
}

.page-content {
  box-sizing: border-box;
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
}

.content-inner {
  padding: 20rpx;
}

.fixed-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  z-index: 100;
  background: #00C37D;
}

.register-header {
  width: 100vw;
  height: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

.register-title {
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.register-subtitle {
  color: #fff;
  font-size: 26rpx;
  margin-bottom: 0;
  opacity: 0.9;
}

.main-scroll {
  box-sizing: border-box;
  padding: 20rpx;
}

.footer {
  position: fixed;
  bottom: 120rpx;
  left: 0;
  width: 100%;
  padding: 20rpx;
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.05);
  z-index: 99;
}

/* 注册类型选择按钮 */
.register-top-btns {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.reg-type-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  background: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  color: #666;
  border: 2rpx solid #e5eefd;
}

.reg-type-btn.active {
  background: #00C37D;
  color: #fff;
  border: none;
}

/* 表单区块 */
.form-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.form-label {
  font-size: 28rpx;
  color: #222;
  margin-bottom: 12rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
}

.tip {
  font-size: 22rpx;
  color: #888;
  margin-left: 8rpx;
  font-weight: normal;
}

/* 输入框样式 */
.form-input {
  width: 100%;
  height: 64rpx;
  font-size: 28rpx;
  border: none;
  border-bottom: 2rpx solid #eee;
  margin-top: 4rpx;
  background: transparent;
  padding: 0 8rpx;
}

/* 标签组 */
.tag-group {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 4rpx;
}

.tag {
  background: #f5f6fa;
  color: #00C37D;
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
  border: 2rpx solid #e5eefd;
}

.tag.selected {
  background: #00C37D;
  color: #fff;
  border: 2rpx solid #00C37D;
}

/* 位置选择 */
.location-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.location-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #00C37D;
  color: #fff;
  border-radius: 44rpx;
  font-size: 32rpx;
  padding: 0;
}

.location-tip {
  font-size: 28rpx;
  color: #999;
}

/* 上传按钮 */
.upload-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #f5f6fa;
  color: #666;
  border-radius: 44rpx;
  font-size: 32rpx;
  border: 2rpx solid #e5eefd;
}

/* 滑块样式 */
.slider {
  margin: 16rpx 0;
}

/* 协议部分 */
.agreement-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #666;
}

.agreement-links {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: #666;
  text-align: center;
}

.link {
  color: #00C37D;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #00C37D;
  color: #fff;
  font-size: 32rpx;
  border-radius: 16rpx;
  text-align: center;
  border: none;
}

.submit-btn[disabled] {
  opacity: 0.6;
  background: #ccc;
} 