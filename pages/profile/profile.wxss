.page {
  width: 100vw;
  min-height: 100vh;
  background: #f5f6fa;
}

.page-content {
  width: 100vw;
  box-sizing: border-box;
}

.content-inner {
  padding: 32rpx;
}

/* 滚动区域 */
.main-scroll {
  width: 100vw;
  height: calc(100vh - 120rpx);
  box-sizing: border-box;
  background: #f5f6fa;
}

/* 个人信息卡片 */
.profile-card {
  width: 100%;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 40rpx 0 32rpx 0;
}

.avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #f2f2f2;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nickname {
  font-size: 30rpx;
  color: #222;
  font-weight: 500;
}

/* 功能按钮区 */
.profile-btns {
  width: 100%;
  margin: 32rpx 0;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  padding: 32rpx 0;
}

.profile-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: none;
  border: none;
  box-shadow: none;
  padding: 0;
}

.profile-btn-icon {
  width: 64rpx;
  height: 64rpx;
  margin-bottom: 8rpx;
  display: block;
}

.profile-btn text {
  font-size: 28rpx;
  color: #333;
}

/* 退出登录区域 */
.logout-section {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.logout-btn {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  border: 2rpx solid #bbb;
  background: #fff;
  color: #888;
  font-size: 30rpx;
  margin: 32rpx 0 16rpx 0;
}

.version {
  color: #bbb;
  font-size: 26rpx;
} 