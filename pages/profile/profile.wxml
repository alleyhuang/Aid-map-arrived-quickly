<!-- 顶部绿色header，固定不动 -->
<view class="fixed-header" style="height:{{statusBarHeightRpx + 260}}rpx;">
  <view style="height:{{statusBarHeightRpx}}rpx;"></view>
  <view class="register-header">
    <view class="register-title">个人中心</view>
    <view class="register-subtitle">您的每一次帮助，都将被记录在此</view>
  </view>
</view>

<!-- 内容区，padding-top避开header -->
<scroll-view scroll-y class="main-scroll" style="height:calc(100vh - {{statusBarHeightRpx + 260}}rpx); padding-top:{{statusBarHeightRpx + 260}}rpx;">
  <view class="profile-card">
    <view class="avatar"></view>
    <view class="nickname">微信用户#18006202552</view>
  </view>

  <view class="profile-btns">
    <view class="profile-btn">
      <view class="icon-placeholder"></view>
      <text>急救消息</text>
    </view>
    <view class="profile-btn">
      <view class="icon-placeholder"></view>
      <text>免责声明</text>
    </view>
    <view class="profile-btn">
      <view class="icon-placeholder"></view>
      <text>我的档案</text>
    </view>
  </view>

  <view class="logout-section">
    <button class="logout-btn">退出登录</button>
    <view class="version">V1.4.51</view>
  </view>
</scroll-view>

<tabbar active="profile" /> 