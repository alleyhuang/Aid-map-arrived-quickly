<!--index.wxml-->
<!-- <navigation-bar title="应急地图" back="true" color="black" background="#FFF"></navigation-bar> -->
<view class="index-tabs">
  <view class="index-tab {{poiType==='help'?'active':''}}" bindtap="onTabChange" data-type="help"
    >附近求助</view
  >
  <view
    class="index-tab {{poiType==='hospital'?'active':''}}"
    bindtap="onTabChange"
    data-type="hospital"
    >医疗地点</view
  >
  <view class="index-tab {{poiType==='aed'?'active':''}}" bindtap="onTabChange" data-type="aed"
    >AED设备</view
  >
  <view
    class="index-tab {{poiType==='shelter'?'active':''}}"
    bindtap="onTabChange"
    data-type="shelter"
    >应急避难所</view
  >
</view>
<view class="pro-bar">
  <view class="pro-bar-text">我有专业能力，可以帮助他人</view>
  <button class="pro-bar-btn" bindtap="onRegister">立即注册</button>
</view>
<view class="map-area map-area-large">
  <map
    id="emergencyMap"
    longitude="{{longitude}}"
    latitude="{{latitude}}"
    scale="16"
    style="width: 100%; height: 70vh; border-radius: 32rpx; overflow: hidden;"
    markers="{{markers}}"
    show-location
    bindmarkertap="onMarkerTap"
  />
  <view class="help-btn-float">
    <view
      class="help-btn-outer {{helpBtnPressing?'pressing':''}}"
      style="width: 200rpx; height: 200rpx;"
    >
      <view
        class="help-btn {{helpBtnPressing?'pressing':''}}"
        style="width: 180rpx; height: 180rpx; background: #e60012; color: #fff; font-size: 44rpx; font-weight: bold;"
        bindtap="onHelp"
        bindtouchstart="onHelpTouchStart"
        bindtouchend="onHelpTouchEnd"
        bindtouchcancel="onHelpTouchEnd"
      >
        <view class="help-btn-inner">
          <svg
            width="180"
            height="180"
            viewBox="0 0 180 180"
            class="help-btn-ring"
            style="position:absolute;left:0;top:0;z-index:2;"
          >
            <circle
              cx="90"
              cy="90"
              r="85"
              stroke="#fff"
              stroke-width="10"
              fill="none"
              opacity="0.2"
            />
            <circle
              cx="90"
              cy="90"
              r="85"
              stroke="#fff"
              stroke-width="10"
              fill="none"
              stroke-linecap="round"
              style="stroke-dasharray: 534; stroke-dashoffset: {{534-534*helpBtnProgress/100}}; transition: stroke-dashoffset 0.1s linear;"
            />
          </svg>
          <text>一键呼救</text>
        </view>
      </view>
    </view>
  </view>
</view>
<tabbar active="index" />
