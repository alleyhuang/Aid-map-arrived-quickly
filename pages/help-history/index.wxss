.container {
  position: relative;
  overflow: hidden;
  padding: 20rpx;
}

.top {
  width: 100%;
}

.app-name {
  font-size: 48rpx;
  font-weight: 400;
}

.press {
  background-color: #f2f2f2;
}

.info {
  width: 100%;
}

.sub-name {
  font-size: 24rpx;
  font-weight: 400;
  color: #6C7B8E;
}

.item {
  border: #6C7B8E 1rpx solid;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 16rpx;
}

.title {
  height: 110rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  margin: 20rpx;
  color: #00CB90;
  border: 1rpx solid #EBEBEB;
  border-radius: 16rpx;
  width: 100%;
}