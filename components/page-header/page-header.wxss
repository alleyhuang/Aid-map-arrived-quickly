.page-header {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  z-index: 100;
  background: #00C37D;
}

.header-content {
  width: 100vw;
  height: 180rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.header-title {
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.header-subtitle {
  color: #fff;
  font-size: 26rpx;
  opacity: 0.9;
} 