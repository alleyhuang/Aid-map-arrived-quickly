.page-header {
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 180rpx;
  z-index: 100;
  background: #00C37D;
  border-radius: 16rpx;
}

.header-title {
  color: #fff;
  font-size: 44rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.header-subtitle {
  color: #fff;
  font-size: 26rpx;
  opacity: 0.9;
} 