      <image class="tabbar-icon" src="data:image/svg+xml;utf8,<svg width='48' height='48' xmlns='http://www.w3.org/2000/svg'><rect x='8' y='8' width='32' height='32' fill='%23e60012'/></svg>" />
    </view>
    <text class="tab-item-text">首页</text>
  </view>
  <view class="tab-item {{active==='chat'?'active':''}}" bindtap="onTab" data-page="chat">
