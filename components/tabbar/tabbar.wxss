.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  background: #fff;
  display: flex;
  flex-direction: row;
  justify-content: space-around;
  align-items: center;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.04);
  z-index: 999;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  color: #bdbdbd;
  font-size: 28rpx;
  transition: color 0.2s;
  position: relative;
}
.tab-item.active {
  color: #00C37D;
  font-weight: 700;
}
.tab-item.active .tab-item-text {
  color: #00C37D;
}
.tab-icon-svg {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 4rpx;
}
.tabbar-icon {
  width: 48rpx;
  height: 48rpx;
}
.tab-item-text {
  font-size: 26rpx;
  color: #888;
  text-align: center;
  width: 100%;
}
/* LV风格装饰 */
.tab-item::after {
  content: '';
  position: absolute;
  bottom: -8rpx;
  left: 50%;
  transform: translateX(-50%) scale(0);
  width: 8rpx;
  height: 8rpx;
  background: #00C37D;
  border-radius: 50%;
  transition: transform 0.2s;
}
.tab-item.active::after {
  transform: translateX(-50%) scale(1);
}
.tab-center {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.center-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #fff;
  border: 4rpx solid #00C37D;
  box-shadow: 0 2rpx 8rpx rgba(0,195,125,0.08);
}
/* 将注释替换为实际类选择器样式，例如： */
.tabbar-view { display: flex; }
.tabbar-text { font-size: 14rpx; }
